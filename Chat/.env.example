# Copy this file to .env.local and fill your real keys.
# Do not commit .env.local.

# Gemini / Google Generative AI
# These names work in the chat route; GOOGLE_API_KEY is also used by the app UI config.
GOOGLE_API_KEY=AIza_your_google_gemini_key_here
# GEMINI_API_KEY=AIza_your_google_gemini_key_here
# GOOGLE_GENERATIVE_AI_API_KEY=AIza_your_google_gemini_key_here

# Optional providers if you switch model in the picker.
ANTHROPIC_API_KEY=sk-ant-your_key_here
GROQ_API_KEY=gsk_your_key_here

# Backend API for medical image/lab/fusion features.
NEXT_PUBLIC_MEDICAL_IMAGE_API_URL=http://localhost:8000
MEDICAL_IMAGE_API_URL=http://localhost:8000
