{
  "name": "mcp-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "backend:dev": "python scripts/run_backend.py --reload",
    "backend:test": "python -m pytest -q",
    "backend:train-demo": "python scripts/create_demo_bone_dataset.py --out-dir examples/demo_bone_dataset --samples-per-class 96 --size 512 --seed 42 && python scripts/train_bone_feature_model.py --data-dir examples/demo_bone_dataset --out-dir models/bone_feature_demo --test-size 0.2 --seed 42 --k 3"
  },
  "dependencies": {
    "@ai-sdk/google": "^1.2.22",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.19.1",
    "next": "16.0.3",
    "pg": "^8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
